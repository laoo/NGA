; Storage on a 512k cartridge: 255 pages of 2048 bytes, page zero being the
; bootstrap's. A Project includes the one document whose geometry is the board it
; names in `container`, and the two are checked against each other.
storage { units 255  size 2048 }
constants { LYNX_PAGE_SIZE = 2048 }
modules { "lynx/cart.asm"  "stream/zx0.asm" }
resident { cart, zx0 }
