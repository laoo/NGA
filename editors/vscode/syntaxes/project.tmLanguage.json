{
  "name": "NGA Project",
  "scopeName": "source.nga.project",
  "patterns": [
    {
      "name": "comment.line.semicolon.nga",
      "match": ";.*$"
    },
    {
      "name": "string.quoted.double.nga",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nga",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.nga",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.nga",
          "match": "\\\\."
        }
      ]
    }
  ]
}
