{
  "name": "NGA C",
  "scopeName": "source.nga.c",
  "patterns": [
    {
      "name": "comment.line.double-slash.nga",
      "match": "//.*$"
    },
    {
      "name": "comment.block.nga",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.nga",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nga",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.nga",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.nga",
          "match": "\\\\."
        }
      ]
    }
  ]
}
