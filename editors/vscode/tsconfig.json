{
  "compilerOptions": {
    "target": "es2022",
    "lib": [ "es2023" ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [ "node" ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": [ "src/**/*.ts", "test/**/*.ts" ]
}
